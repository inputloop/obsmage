[Unit]
Description=Run the obsmage distribution pipeline daily, after the healer's usual hour

[Timer]
OnBootSec=40min
OnCalendar=*-*-* 01:17:00
RandomizedDelaySec=20min
Persistent=true
Unit=obsmage-dist.service

[Install]
WantedBy=timers.target

