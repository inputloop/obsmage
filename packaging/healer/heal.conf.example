# /etc/obsmage/heal.conf -- read by omg-heal (KEY=VALUE, no shell expansion)
SRC=https://example.invalid/obsmage.git
WORK=/var/lib/obsmage-heal
# FOLLOW: main (default) | meta | tagged | tagged+signed
#FOLLOW=main
#PULL=yes
#BRANCH=
#KEYRING=/etc/obsmage/release-keys    # a GNUPGHOME directory, for tagged+signed
BUILD=deb
#PATCHES=/usr/share/obsmage/patches
#DEBIAN=/usr/share/obsmage/debian

