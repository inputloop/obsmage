# pins.env -- everything the Windows pipeline fetches, pinned. KEY=VALUE, no quotes, no spaces.
# Read by omg-win (sh), .github/workflows/windows.yml (PowerShell) and tests/e2e-windows.sh.
#
# The OBS Studio we build against: OBS's own headers at this commit (the tag is for people; the commit is the pin).
# A plugin built against libobs X.Y loads in OBS Studio X.Y and later (libobs refuses one built for a newer X.Y).
OBS_TAG=32.1.0
OBS_COMMIT=5533a277e4400203b50114c993f89878d50a27b9
OBS_GIT=https://github.com/obsproject/obs-studio
#
# The OBS Studio installers the CI load check installs before ours. sha256 taken 2026-11-04 from
# cdn-fastly.obsproject.com; CI fetches from the GitHub release first (a second host) and must get the same bytes.
OBS_TEST_VERSIONS=32.1.0 33.0.1
OBS_SETUP_32_1_0_SHA256=0e3d75eb83951d3fe100cdc7a97fd870f16781bbdcf544fbe101d9b89f9c6231
OBS_SETUP_33_0_1_SHA256=37ecde4d9a28e8aeeb07623c8469b5d558eb264e02ccf435bb859891c401758b
#
