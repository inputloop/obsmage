[Unit]
Description=obsmage build-and-heal (omg-heal heal)
Documentation=file:///usr/share/doc/obsmage/PACKAGING.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/obsmage/heal.conf

[Service]
Type=oneshot
User=obsmage-heal
Group=obsmage-heal
ExecStart=/usr/lib/obsmage/omg-heal --conf /etc/obsmage/heal.conf heal
# WORK in heal.conf should be /var/lib/obsmage-heal (created and owned by systemd below).
StateDirectory=obsmage-heal
StateDirectoryMode=0750
WorkingDirectory=/var/lib/obsmage-heal
Environment=HOME=/var/lib/obsmage-heal
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4h

# Hardening. Builds need a writable work tree, compilers and the network (fetch); nothing else.
# Build dependencies must already be installed: the healer never installs packages.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027
# Not set on purpose: MemoryDenyWriteExecute (some build tools JIT) and PrivateNetwork (fetch needs it).

