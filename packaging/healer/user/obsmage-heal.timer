[Unit]
Description=Run the obsmage build-and-heal check daily and shortly after login

[Timer]
OnBootSec=10min
OnCalendar=daily
RandomizedDelaySec=30min
Persistent=true
Unit=obsmage-heal.service

[Install]
WantedBy=timers.target

